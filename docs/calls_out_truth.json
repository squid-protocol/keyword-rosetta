{
  "_meta": {
    "purpose": "Independent ground-truth oracle for the calls_out_to metric (gitgalaxy#3264 Phase 3). Derived by hand-reading every data/<lang>/ source file on 2026-09-22 with the engine NOT in the loop, so re-blessing expected_signals.json against a new engine build can be validated against corpus-design truth instead of circularly blessing engine output.",
    "semantics": {
      "entry_file": "file containing the dispatch/entry node",
      "entry_node": "the dispatch/entry function name exactly as the engine extracts it",
      "entry_required": "bare callee names that MUST all appear in the entry node's calls_out_to (subset check, order-free)",
      "periphery": "informational per-function planted calls (bare form, minus names the engine's global ignore set filters); a precision-first engine may miss some -- the checker WARNS on these, never fails",
      "forbidden_everywhere": "names that must NEVER appear in any calls_out_to array for this language (decoys, keyword traps); the checker FAILS on these",
      "tolerated_noise": "known false-positive captures currently accepted; listed so future tightening has a ledger",
      "known_gaps": "call edges that exist in the sample but are intentionally not extracted (precision-first), with rationale",
      "expect_empty": "true = every calls_out_to in the manifest must be []; used for no-call-graph corpora and intentionally-blind languages"
    },
    "global_forbidden": ["phantom_decoy_call"],
    "note": "Derived facts double-checked against the samples: cobol's entry deliberately PERFORMs only PROBE-IO and PROBE-RISK; rexx's 'call on error' is a condition trap, never a call; agc_assembly has exactly one real TC call; tcl contains no [bracket] substitutions; python/javascript/rust are the only languages with a real cross-file entry call (a.probe_globals / a.probeGlobals / a::probe_globals)."
  },
  "abap": {
    "entry_file": "main.abap",
    "entry_node": "dispatch",
    "entry_required": ["probe_branch", "probe_io", "probe_risk"],
    "periphery": {"probe_test": ["assert_equals"]},
    "forbidden_everywhere": ["FUNCTION", "METHOD", "TRANSACTION", "WRITE", "TRUNCATE", "SELECT"],
    "known_gaps": {"class_methods": "CL_ABAP_UNIT_ASSERT=>assert_equals( ) style method calls extracted only if the abap rule covers CALL METHOD/=> forms"}
  },
