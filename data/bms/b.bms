* keyword rosetta control shell: bms / b
* decoy: nothing risky lives here in prose
         COPY c
PROBEBYP DFHMDI SIZE=(24,80),LINE=8,COLUMN=1
BYPFLD   DFHMDF POS=(8,1),LENGTH=8,ATTRB=ASKIP
PROBETEL DFHMDI SIZE=(24,80),LINE=9,COLUMN=1
TELFLD   DFHMDF POS=(9,1),LENGTH=8,ATTRB=ASKIP
PROBESTA DFHMDI SIZE=(24,80),LINE=10,COLUMN=1
STAFLD   DFHMDF POS=(10,1),LENGTH=8,ATTRB=ASKIP
         END
