* keyword rosetta control shell: bms / a
* decoy: config reads stay in prose only
         COPY b
PROBEGLB DFHMDI SIZE=(24,80),LINE=5,COLUMN=1
HACKFLD  DFHMDF POS=(5,1),LENGTH=8,ATTRB=ASKIP
PROBETST DFHMDI SIZE=(24,80),LINE=6,COLUMN=1
TSTFLD   DFHMDF POS=(6,1),LENGTH=8,ATTRB=ASKIP
PROBESAF DFHMDI SIZE=(24,80),LINE=7,COLUMN=1
SAFFLD   DFHMDF POS=(7,1),LENGTH=8,ATTRB=ASKIP
         END
